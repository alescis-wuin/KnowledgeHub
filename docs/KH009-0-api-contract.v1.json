{
  "contractId": "KnowledgeHub.Workspaces.API.v1",
  "status": "KH009_0_BASELINE_NOT_IMPLEMENTED",
  "date": "2026-11-02",
  "basePath": "/api/v1/workspaces",
  "targetFrameworks": [
    "net10.0",
    "net10.0-windows10.0.19041.0"
  ],
  "storage": "PostgreSQL 17 + Entity Framework Core 10 (one shared DB with WorkspaceId partition)",
  "security": {
    "type": "OAuth2/OIDC Bearer JWT access token",
    "publicAuthEndpoints": [],
    "serverEnforcement": [
      "Validate iss/aud/exp/signature and scopes",
      "Resolve sub to stable AppUser ID",
      "Check ACTIVE membership for each workspace request",
      "Roles must be server-enforced, never trusted from client",
      "Require email_verified for invitation acceptance",
      "Rate limit create/upload/invite/RAG",
      "Fail closed on unknown tenant or unknown resource",
      "No direct public media URLs for private assets"
    ],
    "roles": {
      "OWNER": [
        "ALL",
        "TRANSFER_OWNERSHIP",
        "ARCHIVE"
      ],
      "ADMIN": [
        "MANAGE_BRANDING",
        "MANAGE_HOME",
        "MANAGE_MEMBERS",
        "MANAGE_CONTENT"
      ],
      "EDITOR": [
        "EDIT_CONTENT",
        "MANAGE_HOME"
      ],
      "MEMBER": [
        "READ",
        "ASK_RAG"
      ],
      "VIEWER": [
        "READ"
      ]
    },
    "roleOrder": [
      "VIEWER",
      "MEMBER",
      "EDITOR",
      "ADMIN",
      "OWNER"
    ],
    "identityKey": "(trusted issuer, stable subject) pair; email and client-provided role must not be used as authorization keys",
    "authorizationSemantics": {
      "noToken": "401 with WWW-Authenticate: Bearer",
      "nonMember": "404 (do not disclose tenant existence)",
      "memberInsufficientRole": "403",
      "missingIfMatch": "428",
      "staleIfMatch": "412",
      "resourceInDifferentWorkspace": "404",
      "archivedWorkspace": "deny until explicitly restored by authorized owner",
      "roleSource": "active membership persisted on server, never JWT role claim alone",
      "globalLegacyRoutes": "No access to tenant-owned data via /api/* legacy endpoints"
    },
    "unresolvedDecisions": [
      "External OIDC issuer/audience selection for KH009.1; never hardcode credentials",
      "Legacy data assignment must be reviewed before enforce migration",
      "Content authorization policy for tenant-scoped embeddings endpoint"
    ]
  },
  "conventions": {
    "successEnvelope": {
      "success": true,
      "statusCode": 200,
      "traceId": "correlation-id",
      "data": "<T>",
      "errors": []
    },
    "errorEnvelope": {
      "success": false,
      "statusCode": 403,
      "traceId": "correlation-id",
      "data": null,
      "errors": [
        "Accès refusé."
      ]
    },
    "legacyRawJsonRoutes": [
      "askClassicRagScoped",
      "askVerifiedRagScoped",
      "vectorSearchScoped",
      "buildContextScoped",
      "generateEmbeddingScoped"
    ],
    "binaryRoutes": [
      "getAssetContent"
    ],
    "correlationHeader": "X-Correlation-ID",
    "strongETagOnRead": [
      "getWorkspace",
      "getBranding",
      "getHomepage",
      "listMembers"
    ],
    "IfMatchRequiredFor": [
      "updateWorkspace",
      "archiveWorkspace",
      "putBranding",
      "putHomepage",
      "changeRole"
    ],
    "httpStatusMeaning": {
      "400": "Invalid payload",
      "401": "Authentication required",
      "403": "Insufficient role",
      "404": "Unknown/inaccessible tenant or object",
      "409": "Slug/asset/membership conflict",
      "412": "ETag mismatch",
      "413": "Media too large",
      "415": "Unsupported media type",
      "422": "Schema, contrast or business-rule failure",
      "429": "Rate limited",
      "428": "If-Match required but missing"
    },
    "idFields": "UUID format for workspaceId, documentId, assetId, invitationId and userId",
    "assetCache": "private, no-store for private images; never embed access token in URL",
    "tenantBehavior": "No silent fallback to legacy global endpoints when active workspace is missing."
  },
