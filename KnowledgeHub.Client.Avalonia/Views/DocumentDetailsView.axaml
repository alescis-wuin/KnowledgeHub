
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KnowledgeHub.Client.Avalonia.ViewModels"
    xmlns:models="using:KnowledgeHub.Client.Avalonia.Models"
    x:Class="KnowledgeHub.Client.Avalonia.Views.DocumentDetailsView"
    x:DataType="vm:DocumentsViewModel">

    <Grid Margin="28"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="16">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="16">

            <Button Grid.Column="0"
                    Content="Retour"
                    Command="{Binding BackToListCommand}" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Details.Title}"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="#DC2626"
                   TextWrapping="Wrap" />

        <ProgressBar Grid.Row="2"
                     Height="4"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}" />

        <TabControl Grid.Row="3">

            <TabItem Header="Contenu">

                <ScrollViewer>
                    <StackPanel Margin="14" Spacing="16">

                        <TextBlock
                            Text="{Binding Details.Category, StringFormat='Catégorie : {0}'}" />

                        <TextBlock
                            Text="{Binding Details.Source, StringFormat='Source : {0}'}" />

                        <TextBlock Text="{Binding TagsText}"
                                   TextWrapping="Wrap" />

                        <TextBlock
                            Text="{Binding Details.CreatedAt, StringFormat='Créé le {0:dd/MM/yyyy HH:mm}'}"
                            Opacity="0.7" />

                        <Separator />

                        <TextBlock Text="{Binding Details.Content}"
                                   TextWrapping="Wrap" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Chunks">

                <ListBox ItemsSource="{Binding Details.Chunks}"
                         Margin="8">

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ChunkDto">

                            <Border Padding="14"
                                    Margin="4,5"
                                    BorderBrush="#64748B"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <StackPanel Spacing="8">

                                    <TextBlock
                                        Text="{Binding ChunkIndex, StringFormat='Chunk n°{0}'}"
                                        FontWeight="Bold" />

                                    <TextBlock
                                        Text="{Binding TokenCount, StringFormat='Tokens : {0}'}"
                                        FontSize="12"
                                        Opacity="0.65" />

                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap" />

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
