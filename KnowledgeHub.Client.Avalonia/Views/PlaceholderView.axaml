
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KnowledgeHub.Client.Avalonia.ViewModels"
    x:Class="KnowledgeHub.Client.Avalonia.Views.PlaceholderView"
    x:DataType="vm:PlaceholderViewModel">

    <StackPanel Margin="32" Spacing="12">
        <TextBlock Text="{Binding Title}"
                   FontSize="28"
                   FontWeight="Bold" />

        <TextBlock Text="{Binding Description}"
                   TextWrapping="Wrap"
                   Opacity="0.7" />
    </StackPanel>
</UserControl>
