
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KnowledgeHub.Client.Avalonia.ViewModels"
    x:Class="KnowledgeHub.Client.Avalonia.Views.DashboardView"
    x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Margin="30" Spacing="20">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="Tableau de bord"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Vue générale de la base de connaissances"
                               Opacity="0.7" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Actualiser"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <ProgressBar
                Height="4"
                IsIndeterminate="True"
                IsVisible="{Binding IsLoading}" />

            <TextBlock
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap"
                Foreground="#DC2626" />

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="16"
                  RowSpacing="16">

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Padding="22"
                        CornerRadius="12"
                        BorderBrush="#64748B"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Documents" Opacity="0.7" />
                        <TextBlock Text="{Binding DocumentsCount}"
                                   FontSize="32"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Padding="22"
                        CornerRadius="12"
                        BorderBrush="#64748B"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Chunks" Opacity="0.7" />
                        <TextBlock Text="{Binding ChunksCount}"
                                   FontSize="32"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Padding="22"
                        CornerRadius="12"
                        BorderBrush="#64748B"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Catégories" Opacity="0.7" />
                        <TextBlock Text="{Binding CategoriesCount}"
                                   FontSize="32"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Padding="22"
                        CornerRadius="12"
                        BorderBrush="#64748B"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Tags" Opacity="0.7" />
                        <TextBlock Text="{Binding TagsCount}"
                                   FontSize="32"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Padding="22"
                        CornerRadius="12"
                        BorderBrush="#64748B"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sources" Opacity="0.7" />
                        <TextBlock Text="{Binding SourcesCount}"
                                   FontSize="32"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
