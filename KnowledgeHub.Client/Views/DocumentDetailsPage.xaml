<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KnowledgeHub.Client.Views.DocumentDetailsPage"
    x:Name="Page"
    Title="Détail du document">

    <Grid
        RowDefinitions="Auto,*">

        <!-- Barre de navigation fixe -->
        <Grid
            Grid.Row="0"
            Padding="16,12"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="12">

            <Button
                Grid.Column="0"
                Text="← Retour"
                Padding="12,8"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Clicked="BackClicked" />

            <Label
                Grid.Column="1"
                Text="Détail du document"
                FontSize="20"
                FontAttributes="Bold"
                LineBreakMode="TailTruncation"
                HorizontalOptions="Start"
                VerticalOptions="Center" />

        </Grid>

        <!-- Zone principale -->
        <Grid
            Grid.Row="1">

            <!-- Chargement -->
            <VerticalStackLayout
                Spacing="12"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsVisible="{Binding IsLoading}">

                <ActivityIndicator
                    WidthRequest="48"
                    HeightRequest="48"
                    IsRunning="{Binding IsLoading}" />

                <Label
                    Text="Chargement du document…"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Contenu du document -->
            <ScrollView
                IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

                <VerticalStackLayout
                    Padding="20"
                    Spacing="20">

                    <!-- Titre -->
                    <Label
                        Text="{Binding Document.Title}"
                        FontSize="28"
                        FontAttributes="Bold"
                        LineBreakMode="WordWrap" />

                    <!-- Résumé -->
                    <Border
                        Padding="16"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout
                            Spacing="8">

                            <Label
                                Text="Résumé"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Document.Summary}"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- Catégorie et source -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Border
                            Grid.Column="0"
                            Padding="14"
                            StrokeShape="RoundRectangle 12">

                            <VerticalStackLayout
                                Spacing="6">

                                <Label
                                    Text="Catégorie"
                                    FontSize="12"
                                    Opacity="0.7" />

                                <Label
                                    Text="{Binding Document.Category}"
                                    FontAttributes="Bold"
                                    LineBreakMode="WordWrap" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="14"
                            StrokeShape="RoundRectangle 12">

                            <VerticalStackLayout
                                Spacing="6">

                                <Label
                                    Text="Source"
                                    FontSize="12"
                                    Opacity="0.7" />

                                <Label
                                    Text="{Binding Document.Source}"
                                    FontAttributes="Bold"
                                    LineBreakMode="WordWrap" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <!-- Mots-clés -->
                    <Border
                        Padding="16"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout
                            Spacing="8">

                            <Label
                                Text="Mots-clés"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Document.SearchKeywords}"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- Contenu complet -->
                    <Border
                        Padding="16"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout
                            Spacing="8">

                            <Label
                                Text="Contenu"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Document.Content}"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- En-tête des chunks -->
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">

                        <Label
                            Grid.Column="0"
                            Text="Chunks"
                            FontSize="20"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                        <Border
                            Grid.Column="1"
                            Padding="10,4"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding Document.Chunks.Count}"
                                FontSize="12"
                                FontAttributes="Bold" />

                        </Border>

                    </Grid>

                    <!--
                        BindableLayout utilisé à la place d'un CollectionView.

                        Cela évite d'imbriquer un CollectionView défilant
                        dans le ScrollView principal.
                    -->
                    <VerticalStackLayout
                        Spacing="10"
                        BindableLayout.ItemsSource="{Binding Document.Chunks}">

                        <BindableLayout.EmptyView>

                            <Border
                                Padding="16"
                                StrokeShape="RoundRectangle 12">

                                <Label
                                    Text="Aucun chunk n'est disponible pour ce document."
                                    HorizontalTextAlignment="Center"
                                    Opacity="0.7" />

                            </Border>

                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Padding="14"
                                    StrokeShape="RoundRectangle 12">

                                    <VerticalStackLayout
                                        Spacing="8">

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="12">

                                            <Label
                                                Grid.Column="0"
                                                Text="Segment documentaire"
                                                FontAttributes="Bold"
                                                VerticalOptions="Center" />

                                            <Border
                                                Grid.Column="1"
                                                Padding="8,3"
                                                StrokeShape="RoundRectangle 8"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding ChunkIndex, StringFormat='Chunk {0}'}"
                                                    FontSize="12"
                                                    FontAttributes="Bold" />

                                            </Border>

                                        </Grid>

                                        <BoxView
                                            HeightRequest="1"
                                            Opacity="0.15" />

                                        <Label
                                            Text="{Binding Content}"
                                            LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                    <!-- Marge basse -->
                    <BoxView
                        HeightRequest="12"
                        Opacity="0" />

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>