<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KnowledgeHub.Client.Views.TagsPage"
    Title="Tags">

    <CollectionView
        ItemsSource="{Binding Tags}">

        <CollectionView.ItemTemplate>

            <DataTemplate>

                <Border
                    Margin="10"
                    Padding="15"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 12">

                    <Label
                        FontSize="18"
                        Text="{Binding Name}" />

                </Border>

            </DataTemplate>

        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>