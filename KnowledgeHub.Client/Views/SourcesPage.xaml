<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KnowledgeHub.Client.Views.SourcesPage"
    Title="Sources">

    <CollectionView
        ItemsSource="{Binding Sources}">

        <CollectionView.ItemTemplate>

            <DataTemplate>

                <Border
                    Margin="10"
                    Padding="15"
                    Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout>

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{Binding Name}" />

                        <Label
                            FontSize="12"
                            Text="{Binding Url}" />

                    </VerticalStackLayout>

                </Border>

            </DataTemplate>

        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>